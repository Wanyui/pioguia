{
  "name": "pioguia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:map": "esbuild src/scripts/map.ts --bundle --minify --splitting --format=esm --platform=browser --target=es2020 --define:import.meta.env.DEV=false --outdir=public/scripts --entry-names=[name] --chunk-names=chunks/[name]-[hash] --loader:.png=file --loader:.svg=file --asset-names=assets/[name]-[hash]",
    "predev": "npm run build:map",
    "dev": "astro dev",
    "prebuild": "npm run build:map",
    "build": "astro build",
    "preview": "astro preview",
    "icons": "node tools/build-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.0.22",
    "astro": "^5.17.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^4.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/leaflet": "^1.9.21",
    "esbuild": "^0.27.3",
    "lucide-static": "^1.59.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.4.5"
  }
}
