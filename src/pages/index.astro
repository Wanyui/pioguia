---
import { getCollection } from "astro:content";
import Map from "../components/Map.astro";
import { buildSearchIndex } from "../lib/search-index";
import { icon } from "../icons";
import "../styles/index.css";

const entries = await getCollection("benefits");
const rawItems = buildSearchIndex(entries);
const initialLang = "es";
const isDev = import.meta.env.DEV;
const BLANK_LOGO_DATA_URI =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";

const normalizeCity = (value: string) =>
  value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\s+/g, " ")
    .trim();

const defaultLogoForCity = (city: string | undefined) => {
  if (!city) return "";
  const normalized = normalizeCity(city);
  if (normalized.includes("andorra la vella")) return "/img/Escut_d'Andorra_la_Vella.svg";
  if (normalized.includes("escaldes-engordany"))
    return "/img/Escut_d'Escaldes-Engordany.svg";
  if (normalized.includes("sant julia de loria"))
    return "/img/Escut_de_Sant_Julia_de_Loria.svg";
  if (normalized.includes("la massana")) return "/img/Escut_de_La_Massana.svg";
  if (normalized.includes("ordino")) return "/img/Escut_d'Ordino.svg.png";
  // Pas de la Casa belong to Encamp parish.
  if (normalized.includes("pas de la casa")) return "/img/Escut_d'Encamp.svg";
  if (normalized.includes("encamp")) return "/img/Escut_d'Encamp.svg";
  // Soldeu belongs to the Canillo parish.
  if (normalized.includes("soldeu")) return "/img/Escut_de_Canillo.svg";
  if (normalized.includes("canillo")) return "/img/Escut_de_Canillo.svg";
  return "";
};

const resolveLogo = (logo: string | undefined, city: string | undefined) => {
  if (!logo || logo === "/img/*") {
    return defaultLogoForCity(city) || BLANK_LOGO_DATA_URI;
  }
  const normalized = logo.trim();
  if (normalized.startsWith("/")) return normalized;
  if (/^https?:\/\//i.test(normalized)) return normalized;
  if (
    /^data:image\/(?:png|jpe?g|gif|webp);base64,[a-z0-9+/=]+$/i.test(normalized)
  ) {
    return normalized;
  }
  return BLANK_LOGO_DATA_URI;
};

const items = rawItems.map((item) => ({
  ...item,
  logo: resolveLogo(item.logo, item.city),
}));

const siteOrigin = (() => {
  const candidates = [Astro.site?.href, import.meta.env.SITE, "http://localhost:4321"];
  for (const candidate of candidates) {
    if (!candidate) continue;
    try {
      return new URL(String(candidate)).origin;
    } catch {
      // Ignore malformed site values and try next fallback.
    }
  }
  return "http://localhost:4321";
})();

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Guía Piolet",
      url: `${siteOrigin}/`,
      inLanguage: ["es", "ca", "en", "fr", "ru"],
    },
    ...items
      .filter((item) => Number.isFinite(item.lat) && Number.isFinite(item.lng) && !(item.lat === 0 && item.lng === 0))
      .map((item) => {
        const logoUrl =
          item.logo && item.logo !== BLANK_LOGO_DATA_URI
            ? item.logo.startsWith("/")
              ? `${siteOrigin}${item.logo}`
              : item.logo
            : undefined;
        const sameAs = [item.googleMapsUrl, item.web].filter(Boolean);
        return {
          "@type": "Place",
          "@id": `${siteOrigin}/#${item.id}`,
          name: item.title.es,
          description: item.description.es,
          ...(item.phone ? { telephone: item.phone } : {}),
          ...(item.web ? { url: item.web } : {}),
          ...(logoUrl ? { image: logoUrl } : {}),
          ...(sameAs.length ? { sameAs } : {}),
          address: {
            "@type": "PostalAddress",
            streetAddress: item.address,
            ...(item.city ? { addressLocality: item.city } : {}),
            addressCountry: "AD",
          },
          geo: {
            "@type": "GeoCoordinates",
            latitude: item.lat,
            longitude: item.lng,
          },
        };
      }),
  ],
};
---

<!doctype html>
<html lang={initialLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/img/marker.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/marker.png" />
    <title>Guía Piolet</title>
    <meta
      name="description"
      content="Guía de ventajas del Club Piolet para consultar beneficios y localizarlos en el mapa."
    />
    <meta name="theme-color" content="#1d7a4f" />
    <meta property="og:title" content="Guía Piolet" />
    <meta
      property="og:description"
      content="Consulta las ventajas del Club Piolet y encuéntralas fácilmente en el mapa."
    />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    {!isDev && <link rel="stylesheet" href="/scripts/map.css" />}
  </head>
  <body class="h-dvh overflow-hidden bg-canvas font-sans text-ink antialiased">
    <div id="app" class="app" data-view="map">
      <header id="app-header" class="app-top">
        <div class="search-row">
          <label class="search-pill">
            <Fragment set:html={icon("search", "icon text-muted")} />
            <input
              id="search-input"
              type="search"
              aria-label="Buscar ventajas"
              placeholder="Buscar por palabra clave (ej: desayuno)"
              autocomplete="off"
            />
            <span class="brand" aria-hidden="true">Pioguia</span>
          </label>
          <div id="lang-controls" class="lang-controls">
            <button
              id="lang-trigger"
              type="button"
              class="lang-trigger"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span id="lang-trigger-label">🇪🇸 Español</span>
            </button>
            <ul id="lang-menu" role="listbox" class="lang-menu hidden">
              <li>
                <button type="button" data-lang-option="es" class="lang-option w-full rounded-lg px-3 py-2 text-left text-sm text-ink transition hover:bg-soft hover:text-accent">🇪🇸 Español</button>
              </li>
              <li>
                <button type="button" data-lang-option="ca" class="lang-option w-full rounded-lg px-3 py-2 text-left text-sm text-ink transition hover:bg-soft hover:text-accent">🇦🇩 Català</button>
              </li>
              <li>
                <button type="button" data-lang-option="en" class="lang-option w-full rounded-lg px-3 py-2 text-left text-sm text-ink transition hover:bg-soft hover:text-accent">🇬🇧 English</button>
              </li>
              <li>
                <button type="button" data-lang-option="fr" class="lang-option w-full rounded-lg px-3 py-2 text-left text-sm text-ink transition hover:bg-soft hover:text-accent">🇫🇷 Français</button>
              </li>
              <li>
                <button type="button" data-lang-option="ru" class="lang-option w-full rounded-lg px-3 py-2 text-left text-sm text-ink transition hover:bg-soft hover:text-accent">🇷🇺 Русский</button>
              </li>
            </ul>
            <select id="lang-select" class="hidden" aria-hidden="true" tabindex="-1">
            <option value="es" selected>Español</option>
            <option value="ca">Català</option>
            <option value="en">English</option>
            <option value="fr">Français</option>
            <option value="ru">Русский</option>
            </select>
          </div>
        </div>
      </header>

      <section class="map-area" aria-label="Mapa">
        <Map id="map" />
        <div class="map-fabs">
          <button id="layers-button" type="button" class="fab" aria-pressed="false" title="Mapa claro" aria-label="Mapa claro">
            <Fragment set:html={icon("layers")} />
          </button>
          <button id="locate-button" type="button" class="fab" title="Volver a mi ubicación" aria-label="Volver a mi ubicación">
            <Fragment set:html={icon("locateFixed")} />
          </button>
        </div>
      </section>

      <aside id="panel" class="panel" data-snap="half" aria-labelledby="page-title">
        <button id="sheet-handle" type="button" class="sheet-handle" aria-label="Ampliar o reducir la lista">
          <span aria-hidden="true"></span>
        </button>
        <div class="panel-head">
          <h1 id="page-title" class="panel-title">Guía de ventajas Piolet</h1>
          <p id="results-count" class="panel-count" aria-live="polite"></p>
        </div>
        <div class="panel-scroll">
          <ul id="results" class="results"></ul>
          <div id="empty-state" class="empty-state" hidden>No se han encontrado resultados.</div>
        </div>
      </aside>

      <nav id="view-toggle" class="view-toggle" aria-label="Vista">
        <button type="button" data-view-button="list" aria-pressed="false">
          <Fragment set:html={icon("list")} />
          <span class="view-label">Lista</span>
        </button>
        <button type="button" data-view-button="map" aria-pressed="true">
          <Fragment set:html={icon("map")} />
          <span class="view-label">Mapa</span>
        </button>
      </nav>
    </div>

    <script
      type="application/json"
      id="benefits-data"
      set:html={JSON.stringify(items)}
    ></script>
    {isDev ? (
      <script type="module" src="/src/scripts/map.ts"></script>
    ) : (
      <script type="module" src="/scripts/map.js"></script>
    )}
  </body>
</html>
